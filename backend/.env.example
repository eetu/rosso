# Copy to backend/.env for local dev. bacon watches this file, so edits restart
# the binary.

# Bypass the forward-auth gate. Local dev only — never in production.
DEV_AUTH=1

ROSSO_BIND=0.0.0.0:3008
ROSSO_DB_PATH=rosso.db
STATIC_DIR=../frontend/dist

# Fetch and readability-parse the linked page when a feed ships only a teaser.
# Set to 0 to leave feeds exactly as published.
ROSSO_EXTRACT=1

# Extraction refuses loopback/private/link-local addresses, because item URLs
# come from the publisher. Set to 1 only for a feed whose articles live on your
# own network.
# ROSSO_EXTRACT_ALLOW_PRIVATE=1

# Ollama on the mini. Leave unset to run as a plain reader with no LLM features —
# the reader works either way.
ROSSO_OLLAMA_URL=http://192.168.1.155:11434
ROSSO_LLM_MODEL=gemma4:e4b-mlx
ROSSO_EMBED_MODEL=embeddinggemma:300m

# One at a time: the mini is a single box whose memory is shared with ComfyUI.
ROSSO_LLM_CONCURRENCY=1
ROSSO_FETCH_CONCURRENCY=4
ROSSO_POLL_TICK_S=60

RUST_LOG=info,rosso_backend=debug
